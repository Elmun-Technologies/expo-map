{
  "name": "expo-map",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Карта экспо-зала и панель продаж — 1 стенд = 3×3 м = 9 м², 1 блок = 8 стендов = 72 м²",
  "scripts": {
    "start": "node server.mjs",
    "validate": "node tools/validate-layout.mjs layout/hall-A.json",
    "test": "node tools/test-validator.mjs",
    "check": "npm run validate && npm test",
    "export": "node tools/export-svg.mjs",
    "export:empty": "node tools/export-svg.mjs --no-state --out exports/hall-A-empty.svg",
    "export:block": "node tools/export-svg.mjs --block",
    "import": "node tools/import-csv.mjs",
    "smoke": "node tests/smoke.mjs",
    "package": "node tools/package.mjs",
    "bookings": "node tools/import-bookings.mjs",
    "preview": "node tools/svg2png.mjs"
  },
  "devDependencies": {
    "jsdom": "^24.1.3",
    "@resvg/resvg-js": "^2.6.2"
  },
  "engines": {
    "node": ">=18"
  }
}
